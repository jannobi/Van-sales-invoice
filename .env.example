# Server
PORT=5000
NODE_ENV=production

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=business_management
DB_USER=postgres
DB_PASSWORD=secure_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY=7d

# Security Codes (Strictly Hidden from UI)
SUPER_ADMIN_ACCESS_CODE=super_admin_secure_code_here
COMPANY_ADMIN_ACCESS_CODE=company_admin_secure_code_here

# Payment Gateways
BKASH_MERCHANT_NUMBER=017XXXXXXXX
BKASH_API_KEY=your_bkash_api_key
NAGAD_MERCHANT_NUMBER=017XXXXXXXX
NAGAD_API_KEY=your_nagad_api_key
BINANCE_PAY_API_KEY=your_binance_api_key
BINANCE_PAY_SECRET=your_binance_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
